# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sih_db

# JWT & Security
JWT_SECRET=replace_with_secure_secret
SESSION_SECRET=replace_with_session_secret

# AI Providers
AI_PROVIDER=MOCK # Options: GEMINI, MOCK
GEMINI_API_KEY=your_api_key_here

# OCR Providers
OCR_PROVIDER=MOCK # Options: AWS_TEXTRACT, GCP_VISION, MOCK

# Gov Verification Providers
GOV_API_BASE_URL=https://mock.gov.api
